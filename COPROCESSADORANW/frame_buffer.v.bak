module frame_buffer (
    input wire clk,
    input wire wr_en,
    input wire [9:0] wr_x,
    input wire [8:0] wr_y,
    input wire [7:0] wr_color_index,
    input wire [9:0] rd_x,
    input wire [8:0] rd_y,
    output wire [7:0] rd_color_index,
    input wire vblank_start_pulse,
    output wire front_sel
);

    wire [16:0] wr_addr = (wr_y << 8) + (wr_y << 6) + wr_x[8:0];
    wire [16:0] rd_addr = (rd_y << 8) + (rd_y << 6) + rd_x[8:0];

    reg front_page = 1'b0;

    always @(posedge clk) begin
        if (vblank_start_pulse)
            front_page <= ~front_page;
    end

    assign front_sel = front_page;

    wire valid_write = wr_en && (wr_x < 10'd320) && (wr_y < 9'd240);
    wire we_ram_a = valid_write & front_page;
    wire we_ram_b = valid_write & ~front_page;

    wire [7:0] q_ram_a, q_ram_b;

    ram_video ip_ram_a (
        .data(wr_color_index),
        .wraddress(wr_addr),
        .wren(we_ram_a),
        .wrclock(clk),
        .rdaddress(rd_addr),
        .rdclock(clk),
        .q(q_ram_a)
    );

    ram_video ip_ram_b (
        .data(wr_color_index),
        .wraddress(wr_addr),
        .wren(we_ram_b),
        .wrclock(clk),
        .rdaddress(rd_addr),
        .rdclock(clk),
        .q(q_ram_b)
    );

    assign rd_color_index = front_page ? q_ram_b : q_ram_a;

endmodule