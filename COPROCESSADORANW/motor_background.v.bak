module motor_background (
    input wire clk,
    input wire reset,
    input wire [9:0] logic_x,
    input wire [8:0] logic_y,
    input wire [31:0] out_scroll_x,
    input wire [31:0] out_scroll_y,
    input wire cpu_we,
    input wire [10:0] cpu_addr,
    input wire [7:0] cpu_data,
    output wire [13:0] endereco_memoria_padroes
);

    wire [8:0] scroll_x = out_scroll_x[8:0];
    wire [7:0] scroll_y = out_scroll_y[7:0];

    wire [9:0] soma_x = logic_x + scroll_x;
    wire [8:0] soma_y = logic_y + scroll_y;

    wire [8:0] x_eff = (soma_x >= 10'd320) ? (soma_x - 10'd320) : soma_x[8:0];
    wire [7:0] y_eff = (soma_y >= 9'd240) ? (soma_y - 9'd240) : soma_y[7:0];

    wire [5:0] coluna = x_eff[8:3];
    wire [4:0] linha = y_eff[7:3];
    wire [2:0] px_in = x_eff[2:0];
    wire [2:0] py_in = y_eff[2:0];

    wire [10:0] tilemap_addr = (linha << 5) + (linha << 3) + coluna;
    wire [7:0] tile_id;

    ram_tilemap ip_memoria_cenario (
        .data(cpu_data),
        .wraddress(cpu_addr),
        .wren(cpu_we),
        .wrclock(clk),
        .rdaddress(tilemap_addr),
        .rdclock(clk),
        .q(tile_id)
    );

    reg [2:0] px_r, py_r;

    always @(posedge clk) begin
        if (reset) begin
            px_r <= 3'd0;
            py_r <= 3'd0;
        end else begin
            px_r <= px_in;
            py_r <= py_in;
        end
    end

    assign endereco_memoria_padroes = {tile_id, py_r, px_r};

endmodule