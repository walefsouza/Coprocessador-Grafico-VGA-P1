module motor_sprites (
    input wire clk,
    input wire reset,
    input wire [9:0] logic_x,
    input wire [8:0] logic_y,
    input wire [31:0] sprite_attr [0:31],
    output reg [10:0] rom_addr,
    input wire [7:0] rom_data,
    output reg [7:0] sprite_color_out
);

    integer i;

    reg prioridade_valida;
    reg [3:0] prioridade_dx, prioridade_dy;
    reg prioridade_espelho_h, prioridade_espelho_v;
    reg [2:0] prioridade_padrao;

    reg s_en;
    reg [8:0] s_x0;
    reg [7:0] s_y0;

    always @(*) begin
        prioridade_valida = 1'b0;
        prioridade_dx = 4'd0;
        prioridade_dy = 4'd0;
        prioridade_espelho_h = 1'b0;
        prioridade_espelho_v = 1'b0;
        prioridade_padrao = 3'd0;

        for (i = 0; i < 32; i = i + 1) begin
            s_en = sprite_attr[i][31];
            s_x0 = sprite_attr[i][25:17];
            s_y0 = sprite_attr[i][16:9];

            if (s_en && (logic_x >= s_x0) && (logic_x < s_x0 + 10'd16) &&
                (logic_y >= s_y0) && (logic_y < s_y0 + 9'd16)) begin

                prioridade_valida = 1'b1;
                prioridade_dx = logic_x - s_x0;
                prioridade_dy = logic_y - s_y0;
                prioridade_espelho_h = sprite_attr[i][27];
                prioridade_espelho_v = sprite_attr[i][26];
                prioridade_padrao = sprite_attr[i][30:28];
            end
        end
    end

    reg prioridade_valida_r;

    always @(posedge clk) begin
        if (reset) begin
            prioridade_valida_r <= 1'b0;
            rom_addr <= 11'd0;
        end else begin
            prioridade_valida_r <= prioridade_valida;

            rom_addr <= {
                prioridade_padrao,
                prioridade_espelho_v ? ~prioridade_dy[3:0] : prioridade_dy[3:0],
                prioridade_espelho_h ? ~prioridade_dx[3:0] : prioridade_dx[3:0]
            };
        end
    end

    always @(posedge clk) begin
        if (reset) begin
            sprite_color_out <= 8'd0;
        end else begin
            if (prioridade_valida_r && rom_data != 8'd0) begin
                sprite_color_out <= rom_data;
            end else begin
                sprite_color_out <= 8'd0;
            end
        end
    end

endmodule