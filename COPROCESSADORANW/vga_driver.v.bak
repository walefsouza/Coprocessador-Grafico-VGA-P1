module vga_driver(
    input clk,
    input reset,
    output VGA_HS,
    output VGA_VS,
    output video_on,
    output VGA_BLANK_N,
    output VGA_SYNC_N,
    output reg [7:0] red,
    output reg [7:0] green,
    output reg [7:0] blue,
    output [9:0] x,
    output [9:0] y,
    output [9:0] pixel_x_raw,
    output [9:0] pixel_y_raw
);

    localparam MAX_H = 800;
    localparam MAX_V = 525;

    reg [9:0] h_counter;
    reg [9:0] v_counter;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            h_counter <= 10'd0;
            v_counter <= 10'd0;
        end else begin
            if (h_counter == MAX_H - 1) begin
                h_counter <= 10'd0;

                if (v_counter == MAX_V - 1) begin
                    v_counter <= 10'd0;
                end else begin
                    v_counter <= v_counter + 10'd1;
                end
            end else begin
                h_counter <= h_counter + 10'd1;
            end
        end
    end

    assign VGA_HS = (h_counter >= 10'd656 && h_counter <= 10'd751) ? 1'b0 : 1'b1;

    assign VGA_VS = (v_counter >= 10'd490 && v_counter <= 10'd491) ? 1'b0 : 1'b1;

    assign video_on = (h_counter <= 639 && v_counter <= 479) ? 1'b1 : 1'b0;

    assign VGA_BLANK_N = video_on;
    assign VGA_SYNC_N = 1'b0;

    assign x = (video_on) ? (h_counter >> 1) : 10'd0;
    assign y = (video_on) ? (v_counter >> 1) : 10'd0;

    assign pixel_x_raw = h_counter;
    assign pixel_y_raw = v_counter;

endmodule